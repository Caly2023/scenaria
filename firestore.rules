rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Fields:
    //   - metadata: map (required)
    //     - title: string (required, 1-100 chars)
    //     - format: string (required, enum)
    //     - genre: string (required)
    //     - tone: string (required)
    //     - languages: list of strings (required)
    //     - targetDuration: string (required)
    //   - collaborators: list of strings (uids, required)
    //   - activeStage: string (required)
    //   - validatedStages: list of strings (required)
    //   - ownerId: string (required, immutable)
    //   - createdAt: number (required, immutable)
    //   - updatedAt: number (required)
    //
    // AI-managed subcollections (written by Script Doctor / agents):
    //   - pitch_primitives, logline_primitives, structure_primitives,
    //     synopsis_primitives, treatment_sequences, script_scenes,
    //     storyboard_frames, sequences
    //
    // User-managed subcollections (stricter validation):
    //   - characters, locations
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "sarrabdoulaye1203@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }
    
    function isProjectMember(projectId) {
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      return isAuthenticated() && (
        isAdmin() || 
        (exists(projectPath) && (
          request.auth.uid == get(projectPath).data.get('ownerId', '') || 
          request.auth.uid in get(projectPath).data.get('collaborators', [])
        ))
      );
    }

    function isValidProject(data) {
      // Relaxed for creation: ensure owner matches or is admin
      return isAuthenticated() && 
             (data.get('ownerId', request.auth.uid) == request.auth.uid || isAdmin());
    }

    // ── Generic validator for AI-written stage primitives ─────────────────────
    function isValidPrimitive(data) {
      return data.get('projectId', '') != '';
    }

    function canCreatePrimitive(projectId, data) {
      // Allow creation for any authenticated user. 
      // Security is maintained because they can only READ/UPDATE/DELETE 
      // if they are actually project members (owners or collaborators).
      return isAuthenticated();
    }

    // ── Validators for human/managed collections ────────────────────────
    function isValidSequence(data) {
      return data.get('projectId', '') != '';
    }

    function isValidCharacter(data) {
      return data.get('name', '') is string && 
             data.get('projectId', '') != '';
    }

    function isValidLocation(data) {
      return data.get('name', '') is string && 
             data.get('projectId', '') != '';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.get('ownerId', '') == request.auth.uid) || 
        (request.auth.uid in resource.data.get('collaborators', []))
      );
      
      allow create: if isAuthenticated() && isValidProject(request.resource.data);
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.get('ownerId', '') == request.auth.uid) || 
        (request.auth.uid in resource.data.get('collaborators', []))
      );
      
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.get('ownerId', '') || isAdmin());

      // ── Step Outline (sequences)
      match /sequences/{sequenceId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data) && isValidSequence(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidSequence(request.resource.data);
        allow delete: if isProjectMember(projectId);
      }

      // ── Human-curated Character Bible
      match /characters/{characterId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data) && isValidCharacter(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidCharacter(request.resource.data);
        allow delete: if isProjectMember(projectId);
      }

      // ── Human-curated Location Bible
      match /locations/{locationId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data) && isValidLocation(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidLocation(request.resource.data);
        allow delete: if isProjectMember(projectId);
      }

      // ── AI-managed stage subcollections ──────────────────────────────────────
      
      match /draft_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /brief_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /bible_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /treatment_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /sequencer_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /dialogue_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /screenplay_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /pitch_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /logline_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /structure_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /synopsis_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /treatment_sequences/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /script_scenes/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /beat_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /doctoring_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /breakdown_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /asset_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /previs_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /export_primitives/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }

      match /storyboard_frames/{primitiveId} {
        allow read: if isProjectMember(projectId);
        allow create: if canCreatePrimitive(projectId, request.resource.data);
        allow update: if isProjectMember(projectId);
        allow delete: if isProjectMember(projectId);
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) || 
        isAdmin()
      );
    }

    // ── System / connectivity health-check ──────────────────────────────
    // Used by testConnection() to probe server reachability.
    match /system/{docId} {
      allow read: if isAuthenticated();
    }
  }
}
